<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Elemental Explorer</title>
<style>
body {
    margin: 0;
    overflow: hidden;
    background-color: #2c3e50;
    font-family: monospace;
    color: white;
}
canvas {
    display: block;
}
#ui {
    position: absolute;
    top: 15px;
    left: 15px;
    pointer-events: none;
    font-size: 18px;
    background: rgba(0, 0, 0, 0.5);
    padding: 15px;
    border-radius: 8px;
}
.stat {
    margin-bottom: 8px;
}
</style>
</head>
<body>
<div id="ui">
    <div id="hp" class="stat">HP: 100</div>
    <div id="element" class="stat">Element: Fire</div>
    <div id="controls" class="stat" style="font-size: 14px; color: #ccc;">WASD: Move | Click: Attack | 1, 2, 3: Switch Element</div>
    <div id="score" class="stat">Score: 0</div>
</div>
<canvas id="gameCanvas"></canvas>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

const uiHp = document.getElementById('hp');
const uiElement = document.getElementById('element');
const uiScore = document.getElementById('score');

let keys = {};
window.addEventListener('keydown', e => keys[e.key.toLowerCase()] = true);
window.addEventListener('keyup', e => keys[e.key.toLowerCase()] = false);

let mouse = { x: 0, y: 0, down: false };
window.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });
window.addEventListener('mousedown', () => mouse.down = true);
window.addEventListener('mouseup', () => mouse.down = false);

const elements = [
    { name: 'Pyro (Fire)', color: '#e74c3c' },
    { name: 'Hydro (Water)', color: '#3498db' },
    { name: 'Dendro (Nature)', color: '#2ecc71' }
];

let currentElement = 0;
let player = { x: canvas.width / 2, y: canvas.height / 2, size: 20, speed: 5, hp: 100 };
let projectiles = [];
let enemies = [];
let score = 0;
let lastShoot = 0;

function spawnEnemy() {
    let side = Math.floor(Math.random() * 4);
    let ex, ey;
    
    if (side === 0) { ex = Math.random() * canvas.width; ey = -30; }
    else if (side === 1) { ex = canvas.width + 30; ey = Math.random() * canvas.height; }
    else if (side === 2) { ex = Math.random() * canvas.width; ey = canvas.height + 30; }
    else { ex = -30; ey = Math.random() * canvas.height; }
    
    let el = Math.floor(Math.random() * 3);
    enemies.push({ x: ex, y: ey, size: 18, speed: 2, hp: 40, element: el });
}

setInterval(spawnEnemy, 1200);

window.addEventListener('keydown', e => {
    if (e.key === '1') currentElement = 0;
    if (e.key === '2') currentElement = 1;
    if (e.key === '3') currentElement = 2;
});

function update() {
    if (keys['w']) player.y -= player.speed;
    if (keys['s']) player.y += player.speed;
    if (keys['a']) player.x -= player.speed;
    if (keys['d']) player.x += player.speed;

    player.x = Math.max(player.size, Math.min(canvas.width - player.size, player.x));
    player.y = Math.max(player.size, Math.min(canvas.height - player.size, player.y));

    uiElement.innerText = 'Element: ' + elements[currentElement].name;
    uiElement.style.color = elements[currentElement].color;
    uiHp.innerText = 'HP: ' + player.hp;
    uiScore.innerText = 'Score: ' + score;

    let now = Date.now();
    if (mouse.down && now - lastShoot > 200) {
        let angle = Math.atan2(mouse.y - player.y, mouse.x - player.x);
        projectiles.push({
            x: player.x, y: player.y,
            vx: Math.cos(angle) * 10, vy: Math.sin(angle) * 10,
            element: currentElement, size: 6, life: 80
        });
        lastShoot = now;
    }

    for (let i = projectiles.length - 1; i >= 0; i--) {
        let p = projectiles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.life--;
        if (p.life <= 0 || p.x < 0 || p.x > canvas.width || p.y < 0 || p.y > canvas.height) {
            projectiles.splice(i, 1);
        }
    }

    for (let i = enemies.length - 1; i >= 0; i--) {
        let e = enemies[i];
        let angle = Math.atan2(player.y - e.y, player.x - e.x);
        
        e.x += Math.cos(angle) * e.speed;
        e.y += Math.sin(angle) * e.speed;

        let dist = Math.hypot(player.x - e.x, player.y - e.y);
        if (dist < player.size + e.size) {
            player.hp -= 15;
            enemies.splice(i, 1);
            if (player.hp <= 0) {
                alert('Game Over! Final Score: ' + score);
                player.hp = 100;
                score = 0;
                enemies = [];
                projectiles = [];
            }
            continue;
        }

        for (let j = projectiles.length - 1; j >= 0; j--) {
            let p = projectiles[j];
            let pd = Math.hypot(p.x - e.x, p.y - e.y);
            
            if (pd < p.size + e.size) {
                let dmg = 15;
                
                if ((p.element === 0 && e.element === 2) || 
                    (p.element === 1 && e.element === 0) || 
                    (p.element === 2 && e.element === 1)) {
                    dmg = 45;
                } else if (p.element === e.element) {
                    dmg = 5;
                }

                e.hp -= dmg;
                projectiles.splice(j, 1);
                
                if (e.hp <= 0) {
                    score += 10;
                    enemies.splice(i, 1);
                }
                break;
            }
        }
    }
}

function draw() {
    ctx.fillStyle = '#2c3e50';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
    ctx.beginPath();
    for (let i = 0; i < canvas.width; i += 50) {
        ctx.moveTo(i, 0); ctx.lineTo(i, canvas.height);
    }
    for (let i = 0; i < canvas.height; i += 50) {
        ctx.moveTo(0, i); ctx.lineTo(canvas.width, i);
    }
    ctx.stroke();

    for (let e of enemies) {
        ctx.fillStyle = elements[e.element].color;
        ctx.beginPath();
        ctx.arc(e.x, e.y, e.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#000';
        ctx.lineWidth = 2;
        ctx.stroke();
    }

    for (let p of projectiles) {
        ctx.fillStyle = elements[p.element].color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();
    }

    ctx.fillStyle = elements[currentElement].color;
    ctx.beginPath();
    ctx.arc(player.x, player.y, player.size, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 3;
    ctx.stroke();
}

function loop() {
    update();
    draw();
    requestAnimationFrame(loop);
}

loop();

window.addEventListener('resize', () => {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
});
</script>
</body>
</html>
